ntor-field-group .elementor-field, .elementor-widget-form .elementor-field-subgroup label{font-size:var( --e-global-typography-text-font-size );line-height:var( --e-global-typography-text-line-height );}.elementor-widget-form .elementor-button{font-size:var( --e-global-typography-accent-font-size );line-height:var( --e-global-typography-accent-line-height );letter-spacing:var( --e-global-typography-accent-letter-spacing );}.elementor-widget-form .elementor-message{font-size:var( --e-global-typography-text-font-size );line-height:var( --e-global-typography-text-line-height );}.elementor-widget-form .e-form__indicators__indicator, .elementor-widget-form .e-form__indicators__indicator__label{font-size:var( --e-global-typography-accent-font-size );line-height:var( --e-global-typography-accent-line-height );letter-spacing:var( --e-global-typography-accent-letter-spacing );}.elementor-widget-form .e-form__indicators__indicator__progress__meter{font-size:var( --e-global-typography-accent-font-size );line-height:var( --e-global-typography-accent-line-height );letter-spacing:var( --e-global-typography-accent-letter-spacing );}}</style><form method=\"post\" name=\"Referral\" aria-label=\"Referral\"><input name=\"post_id\" type=\"hidden\" value=\"9888\" />\r\n<input name=\"form_id\" type=\"hidden\" value=\"403c0373\" />\r\n<input name=\"referer_title\" type=\"hidden\" value=\"Alumni - Hippocrates Wellness\" />\r\n<input name=\"queried_id\" type=\"hidden\" value=\"9701\" />\r\n<label for=\"form-field-firstname\">\r\nYour name* </label>\r\n<input id=\"form-field-firstname\" name=\"form_fields\" required=\"required\" size=\"1\" type=\"text\" />\r\n<label for=\"form-field-email\">\r\nYour email* </label>\r\n<input id=\"form-field-email\" name=\"form_fields\" required=\"required\" size=\"1\" type=\"email\" />\r\n<label for=\"form-field-friend\">\r\nTheir first name* </label>\r\n<input id=\"form-field-friend\" name=\"form_fields\" required=\"required\" size=\"1\" type=\"text\" />\r\n<label for=\"form-field-friendemail\">\r\nTheir email* </label>\r\n<input id=\"form-field-friendemail\" name=\"form_fields\" required=\"required\" size=\"1\" type=\"email\" />\r\n<label for=\"form-field-note\">\r\nA line from you </label>\r\n<textarea id=\"form-field-note\" name=\"form_fields\" rows=\"4\" placeholder=\"Optional — we include it in the introduction\"></textarea>\r\n<input id=\"form-field-permission-0\" name=\"form_fields\" type=\"checkbox\" value=\"yes\" /> <label for=\"form-field-permission-0\">I have asked them, and they are happy to hear from Hippocrates.</label>\r\n<button type=\"submit\">\r\n\r\nSend the introduction\r\n</button></form>Share your experience\r\n<h3>Your story may be the reason someone else begins</h3>\r\nWrite as much or as little as you like, honestly. We publish alumni stories with permission, and we would rather have a true account than a glowing one.\r\n\r\n<a href=\"#story-route\">\r\nWrite a review\r\n<em>Destination to be confirmed →</em>\r\n</a>\r\n<a href=\"#story-route\">\r\nSend us your story\r\n<em>Submission process to be confirmed →</em>\r\n</a>\r\n<a href=\"#story-route\">\r\nRecord a short video\r\n<em>Upload route to be confirmed →</em>\r\n</a>\r\n\r\nNothing here asks for positive reviews only, and no review platform is named until confirmed.\r\n\r\n</section><section>Community\r\n<h2>What’s happening in the alumni community</h2>\r\n<a href=\"#events\">See all events→</a>\r\n<img src=\"/wp-content/uploads/2026/08/hw-alumni-comm1-2.jpg\" alt=\"\" />\r\n<h3>Alumni gatherings</h3>\r\nOn-campus and regional gatherings for people who have stayed with us.\r\n\r\n<img src=\"/wp-content/uploads/2026/08/hw-alumni-comm2-2.jpg\" alt=\"\" />\r\n<h3>Events &amp; tours</h3>\r\nOpen events on campus you are welcome to attend, and to bring someone to.\r\n\r\n<img src=\"/wp-content/uploads/2026/08/hw-alumni-comm3-2.jpg\" alt=\"\" />\r\n<h3>Continuing education</h3>\r\nTalks, classes and resources that pick up where the program left off.\r\n\r\n</section><section>Stay more involved\r\n<h2>For alumni who want a closer relationship</h2>\r\nSome alumni stay involved beyond their own routine — speaking about their experience, supporting new guests, or representing Hippocrates in their own community. That path is the Ambassador program, and it involves a conversation rather than a signup.\r\n\r\n<a href=\"/ambassadors/\">About the Ambassador program→</a>\r\n<a href=\"/ambassadors/#apply\">Express interest→</a>\r\n\r\n</section><section><img src=\"/wp-content/uploads/2026/08/hw-logo-mark-light-15.svg\" alt=\"\" aria-hidden=\"true\" />\r\n<h2>Your time on campus ended. Your connection didn’t.</h2>\r\nContinue at home, come back when you are ready, or simply stay in touch with the community that started here with you.\r\n\r\n<a href=\"/at-home/\">Continue your journey→</a>\r\n<a href=\"#elementor-action%3Aaction%3Dpopup%3Aopen%26settings%3DeyJpZCI6IjM1NDQiLCJ0b2dnbGUiOmZhbHNlfQ%3D%3D\">Plan your return→</a>\r\n\r\n</section>", "seoTitle": "Hippocrates Wellness Alumni Community | %%sitename%%", "seoDesc": "Stay connected with the Hippocrates Wellness alumni community, continue your wellness journey, plan your return and explore ways to stay involved.", "canonical": null, "ogTitle": null, "ogDesc": null, "image": null, "terms": {}, "elementor": true}
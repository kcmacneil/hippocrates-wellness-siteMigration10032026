othing: antialiased;opacity: 1; }\n.slick-dots li.slick-active button:before \n { color: black;  width: 18px; background-color:black;position: absolute; top: 0; left: 0; height: 18px; \n }\n.slick-dots li button::before {\n   content: \"\";\n   }\n@media screen and (max-width:1024px){\n    .video_slider button.slick-prev.slick-arrow {\n    left: -40px;\n}\n    .video_slider button.slick-next.slick-arrow {\n    right: -20px;\n}\n}\n</style>\n\t\thttps://vimeo.com/1051088353/195ddc6682?fl=ls&#038;fe=ec\t\t\n\t\t\t\t\t<h2>Jennifer</h2>\t\t\t\t\n\t\t\t\t\t<h2>Hippocrates Wellness Alumni</h2>\t\t\t\t\n\t\thttps://vimeo.com/1051094959/fd35aa935d?fl=ls&#038;fe=ec\t\t\n\t\t\t\t\t<h2>Marrisa</h2>\t\t\t\t\n\t\t\t\t\t<h2>Hippocrates Wellness Alumni</h2>\t\t\t\t\n\t\thttps://vimeo.com/1051094995/a0511f65ee?fl=ls&#038;fe=ec\t\t\n\t\t\t\t\t<h2>Arthur</h2>\t\t\t\t\n\t\t\t\t\t<h2>Hippocrates Wellness Alumni</h2>\t\t\t\t\n\t\thttps://vimeo.com/1051095071/e1965cab3e?fl=ls&#038;fe=ec\t\t\n\t\t\t\t\t<h2>Synia</h2>\t\t\t\t\n\t\t\t\t\t<h2>Hippocrates Wellness Alumni</h2>\t\t\t\t\n\t\t\t\t\t<iframe id=\"ssf_SzJKTjVKMbbQNTVPTtQ1MbQ0001MNUvWNUtONDAzNUlLMzYxAgA\" data-form-id=\"SzJKTjVKMbbQNTVPTtQ1MbQ0001MNUvWNUtONDAzNUlLMzYxAgA\" data-instance-id=\"g08u17\" src=\"https://app-3QNNGVUVKI.marketingautomation.services/prospector/form/MzawMLEwNjMxBgA/SzJKTjVKMbbQNTVPTtQ1MbQ0001MNUvWNUtONDAzNUlLMzYxAgA?rf__sb=https%3A%2F%2Fhippocratesdev.wpenginepowered.com%2Fprograms%2Fresort-programs%2F1-week-vitality-passport&amp;agentreferrer__sb=https%3A%2F%2Fhippocratesdev.wpenginepowered.com%2F&amp;_tk=202409|66d5d7a691385c78503cfcdd&amp;instance=g08u17\" style=\"overflow-y: auto;\" frameborder=\"0\" width=\"100%\"></iframe>\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img width=\"800\" height=\"160\" src=\"/wp-content/uploads/2025/04/hippocrates-wellness-logo.svg\" alt=\"\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t<h2>Everything you need for a life full of wellness</h2>\t\t\t\t\n\t\t<p><strong>Taking care o
-field-group .elementor-field, .elementor-widget-form .elementor-field-subgroup label{font-size:var( --e-global-typography-text-font-size );line-height:var( --e-global-typography-text-line-height );}.elementor-widget-form .elementor-button{font-size:var( --e-global-typography-accent-font-size );line-height:var( --e-global-typography-accent-line-height );letter-spacing:var( --e-global-typography-accent-letter-spacing );}.elementor-widget-form .elementor-message{font-size:var( --e-global-typography-text-font-size );line-height:var( --e-global-typography-text-line-height );}.elementor-widget-form .e-form__indicators__indicator, .elementor-widget-form .e-form__indicators__indicator__label{font-size:var( --e-global-typography-accent-font-size );line-height:var( --e-global-typography-accent-line-height );letter-spacing:var( --e-global-typography-accent-letter-spacing );}.elementor-widget-form .e-form__indicators__indicator__progress__meter{font-size:var( --e-global-typography-accent-font-size );line-height:var( --e-global-typography-accent-line-height );letter-spacing:var( --e-global-typography-accent-letter-spacing );}}</style><form method=\"post\" name=\"Ambassadors\" aria-label=\"Ambassadors\"><input name=\"post_id\" type=\"hidden\" value=\"9886\" />\r\n<input name=\"form_id\" type=\"hidden\" value=\"7d595da1\" />\r\n<input name=\"referer_title\" type=\"hidden\" value=\"\" />\r\n<label for=\"form-field-firstname\">\r\nFirst name* </label>\r\n<input id=\"form-field-firstname\" name=\"form_fields[firstname]\" required=\"required\" size=\"1\" type=\"text\" />\r\n<label for=\"form-field-lastname\">\r\nLast name* </label>\r\n<input id=\"form-field-lastname\" name=\"form_fields[lastname]\" required=\"required\" size=\"1\" type=\"text\" />\r\n<label for=\"form-field-email\">\r\nEmail* </label>\r\n<input id=\"form-field-email\" name=\"form_fields[email]\" required=\"required\" size=\"1\" type=\"email\" />\r\n<label for=\"form-field-phone\">\r\nPhone </label>\r\n<input id=\"form-field-phone\" title=\"Only numbers and phone characters (#, -, *, etc) are accepted.\" name=\"form_fields[phone]\" pattern=\"[0-9()#&amp;+*-=.]+\" size=\"1\" type=\"tel\" placeholder=\"Optional\" />\r\n<label for=\"form-field-country\">\r\nLocation / country </label>\r\n<input id=\"form-field-country\" name=\"form_fields[country]\" size=\"1\" type=\"text\" placeholder=\"Optional — helps with travel and timing\" />\r\n<label for=\"form-field-platform\">\r\nPrimary platform* </label>\r\n\r\n<select id=\"form-field-platform\" name=\"form_fields[platform]\" required=\"required\">\r\n<option value=\"instagram\">Instagram</option>\r\n<option value=\"tiktok\">TikTok</option>\r\n<option value=\"youtube\">YouTube</option>\r\n<option value=\"podcast\">Podcast</option>\r\n<option value=\"blog\">Blog / publication</option>\r\n<option value=\"other\">Other</option>\r\n</select>\r\n<label for=\"form-field-url\">\r\nMain profile or channel* </label>\r\n<input id=\"form-field-url\" name=\"form_fields[url]\" required=\"required\" size=\"1\" type=\"text\" />\r\n<label for=\"form-field-url2\">\r\nAnother platform </label>\r\n<input id=\"form-field-url2\" name=\"form_fields[url2]\" size=\"1\" type=\"text\" placeholder=\"Optional\" />\r\n<label for=\"form-field-audience\">\r\nAudience size </label>\r\n\r\n<select id=\"form-field-audience\" name=\"form_fields[audience]\">\r\n<option value=\"undisclosed\">Prefer not to say</option>\r\n<option value=\"under-10k\">Under 10k</option>\r\n<option value=\"10k-50k\">10k – 50k</option>\r\n<option value=\"50k-250k\">50k – 250k</option>\r\n<option value=\"250k-1m\">250k – 1M</option>\r\n<option value=\"over-1m\">Over 1M</option>\r\n</select>\r\n<label for=\"form-field-focus\">\r\nPrimary content focus* </label>\r\n\r\n<select id=\"form-field-focus\" name=\"form_fields[focus]\" required=\"required\">\r\n<option value=\"wellness\">Wellness</option>\r\n<option value=\"health-education\">Health education</option>\r\n<option value=\"lifestyle\">Lifestyle</option>\r\n<option value=\"nutrition\">Nutrition</option>\r\n<option value=\"fitness\">Fitness</option>\r\n<option value=\"travel\">Travel</option>\r\n</select>\r\n<label for=\"form-field-been\">\r\nHave you been to Hippocrates before? </label>\r\n\r\n<select id=\"form-field-been\" name=\"form_fields[been]\">\r\n<option value=\"yes\">Yes</option>\r\n<option value=\"no\">No</option>\r\n</select>\r\n<label for=\"form-field-about\">\r\nTell us about your audience* </label>\r\n<textarea id=\"form-field-about\" name=\"form_fields[about]\" required=\"required\" rows=\"4\"></textarea>\r\n<label for=\"form-field-why\">\r\nWhy Hippocrates?* </label>\r\n<textarea id=\"form-field-why\" name=\"form_fields[why]\" required=\"required\" rows=\"4\"></textarea>\r\n<label for=\"form-field-kit\">\r\nMedia kit link </label>\r\n<input id=\"form-field-kit\" name=\"form_fields[kit]\" size=\"1\" type=\"text\" placeholder=\"Optional\" />\r\n<input id=\"form-field-updates-0\" name=\"form_fields[updates]\" type=\"checkbox\" value=\"yes\" /> <label for=\"form-field-updates-0\">I’m happy for Hippocrates to contact me about this enquiry.</label>\r\n<button type=\"submit\">\r\n\r\nSubmit interest\r\n</button></form></section><section>What happens next\r\n<h2>After you submit</h2>\r\n01\r\n<h3>We read it</h3>\r\nEvery submission is reviewed by the team.\r\n\r\n02\r\n<h3>We may get in touch</h3>\r\nIf there looks to be a fit, someone will reach out for a conversation.\r\n\r\n03\r\n<h3>Details come then</h3>\r\nArrangements and expectations are discussed privately, with partners we take forward.\r\n\r\n</section>", "seoTitle": "Wellness Ambassador Program | %%sitename%%", "seoDesc": "Explore partnership opportunities with Hippocrates Wellness for aligned creators, educators and organizations who share our vision for better health and wellness.", "canonical": null, "ogTitle": null, "ogDesc": null, "image": null, "terms": {}, "elementor": true}
ze:var( --e-global-typography-accent-font-size );line-height:var( --e-global-typography-accent-line-height );letter-spacing:var( --e-global-typography-accent-letter-spacing );}.elementor-widget-form .e-form__indicators__indicator__progress__meter{font-size:var( --e-global-typography-accent-font-size );line-height:var( --e-global-typography-accent-line-height );letter-spacing:var( --e-global-typography-accent-letter-spacing );}}</style>\t\t\n\t\t\t\t\t\t\t<form method=\"post\" name=\"Plan\" aria-label=\"Plan\">\n\t\t\t<input type=\"hidden\" name=\"post_id\" value=\"11006\"/>\n\t\t\t<input type=\"hidden\" name=\"form_id\" value=\"21ac7198\"/>\n\t\t\t<input type=\"hidden\" name=\"referer_title\" value=\"Trauma Integration Program - Hippocrates Wellness\" />\n\t\t\t\t\t\t\t<input type=\"hidden\" name=\"queried_id\" value=\"9712\"/>\n\t\t\t\t\t\t\t\t\t\t\t\t<label for=\"form-field-firstname\">\n\t\t\t\t\t\t\t\tName*\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<input size=\"1\" type=\"text\" name=\"form_fields\" id=\"form-field-firstname\" placeholder=\"Your first name\" required=\"required\">\n\t\t\t\t\t\t\t\t\t\t\t\t<label for=\"form-field-lastname\">\n\t\t\t\t\t\t\t\tLast name*\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<input size=\"1\" type=\"text\" name=\"form_fields\" id=\"form-field-lastname\" placeholder=\"Your last name\" required=\"required\">\n\t\t\t\t\t\t\t\t\t\t\t\t<label for=\"form-field-email\">\n\t\t\t\t\t\t\t\tEmail address*\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<input size=\"1\" type=\"email\" name=\"form_fields\" id=\"form-field-email\" placeholder=\"name@example.com\" required=\"required\">\n\t\t\t\t\t\t\t\t\t\t\t\t<label for=\"form-field-phone\">\n\t\t\t\t\t\t\t\tPhone / WhatsApp*\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t\t\t<input size=\"1\" type=\"tel\" name=\"form_fields\" id=\"form-field-phone\" placeholder=\"Include the country code\" required=\"required\" pattern=\"[0-9()#&amp;+*-=.]+\" title=\"Only numbers and phone characters (#, -, *, etc) are accepted.\">\n\t\t\t\t\t\t\t\t\t\t\t\t<label for=\"form-field-country\">\n\t\t\t\t\t\t\t\tCountry of residence*\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<input size=\"1\" type=\"text\" name=\"form_fields\" id=\"form-field-country\" placeholder=\"Country\" required=\"required\">\n\t\t\t\t\t\t\t\t\t\t\t\t<label for=\"form-field-prefer\">\n\t\t\t\t\t\t\t\tPreferred contact method\t\t\t\t\t\t\t</label>\n\t\t\t\t<svg aria-hidden=\"true\" viewBox=\"0 0 571.4 571.4\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M571 393Q571 407 561 418L311 668Q300 679 286 679T261 668L11 418Q0 407 0 393T11 368 36 357H536Q550 357 561 368T571 393Z\"></path></svg>\t\t\t\n\t\t\t<select name=\"form_fields\" id=\"form-field-prefer\">\n\t\t\t\t\t\t\t\t\t<option value=\"email\">Email</option>\n\t\t\t\t\t\t\t\t\t<option value=\"phone\">Phone</option>\n\t\t\t\t\t\t\t\t\t<option value=\"whatsapp\">WhatsApp</option>\n\t\t\t\t\t\t\t\t\t<option value=\"either\">Either is fine</option>\n\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t\t\t\t\t<label for=\"form-field-interest\">\n\t\t\t\t\t\t\t\tJourney of interest\t\t\t\t\t\t\t</label>\n\t\t\t\t<svg aria-hidden=\"true\" viewBox=\"0 0 571.4 571.4\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M571 393Q571 407 561 418L311 668Q300 679 286 679T261 668L11 418Q0 407 0 393T11 368 36 357H536Q550 357 561 368T571 393Z\"></path></svg>\t\t\t\n\t\t\t<select name=\"form_fields\" id=\"form-field-interest\">\n\t\t\t\t\t\t\t\t\t<option value=\"help-me-choose\">Help me choose</option>\n\t\t\t\t\t\t\t\t\t<option value=\"resilience\">Integrative Cancer Support &amp; Whole-Person Wellness Education</option>\n\t\t\t\t\t\t\t\t\t<option value=\"fortitude\">Immune Health &amp; Autoimmune Wellness Program</option>\n\t\t\t\t\t\t\t\t\t<option value=\"cadence\">Cardiovascular Wellness &amp; Heart-Health Program</option>\n\t\t\t\t\t\t\t\t\t<option value=\"renewal\">Metabolic Reset &amp; Blood-Sugar Wellness Program</option>\n\t\t\t\t\t\t\t\t\t<option value=\"acuity\">Cognitive Wellness &amp; Brain-Health Program</option>\n\t\t\t\t\t\t\t\t\t<option value=\"restoration\">Chronic Fatigue &amp; Immune Resilience Wellness Program</option>\n\t\t\t\t\t\t\t\t\t<option value=\"genesis\">Fertility &amp; Reproductive Wellness Program</option>\n\t\t\t\t\t\t\t\t\t<option value=\"root\">Stress Recovery &amp; Nervous-System Wellness Program</option>\n\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t\t\t\t\t<label for=\"form-field-timing\">\n\t\t\t\t\t\t\t\tPreferred timeframe\t\t\t\t\t\t\t</label>\n\t\t\t\t<svg aria-hidden=\"true\" viewBox=\"0 0 571.4 571.4\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M571 393Q571 407 561 418L311 668Q300 679 286 679T261 668L11 418Q0 407 0 393T11 368 36 357H536Q550 357 561 368T571 393Z\"></path></svg>\t\t\t\n\t\t\t<select name=\"form_fields\" id=\"form-field-timing\">\n\t\t\t\t\t\t\t\t\t<option value=\"asap\">As soon as possible</option>\n\t\t\t\t\t\t\t\t\t<option value=\"0-3m\">Within 3 months</option>\n\t\t\t\t\t\t\t\t\t<option value=\"3-6m\">3–6 months</option>\n\t\t\t\t\t\t\t\t\t<option value=\"6-12m\">6–12 months</option>\n\t\t\t\t\t\t\t\t\t<option value=\"exploring\">Just exploring</option>\n\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t\t\t\t\t<label for=\"form-field-guests\">\n\t\t\t\t\t\t\t\tNumber of guests\t\t\t\t\t\t\t</label>\n\t\t\t\t<svg aria-hidden=\"true\" viewBox=\"0 0 571.4 571.4\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M571 393Q571 407 561 418L311 668Q300 679 286 679T261 668L11 418Q0 407 0 393T11 368 36 357H536Q550 357 561 368T571 393Z\"></path></svg>\t\t\t\n\t\t\t<select name=\"form_fields\" id=\"form-field-guests\">\n\t\t\t\t\t\t\t\t\t<option value=\"1\">1 guest</option>\n\t\t\t\t\t\t\t\t\t<option value=\"2\">2 guests</option>\n\t\t\t\t\t\t\t\t\t<option value=\"3\">3 guests</option>\n\t\t\t\t\t\t\t\t\t<option value=\"4-plus\">4 or more</option>\n\t\t\t\t\t\t\t\t\t<option value=\"unsure\">Not sure yet</option>\n\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t\t\t\t\t<label for=\"form-field-heard\">\n\t\t\t\t\t\t\t\tHow did you hear about us?\t\t\t\t\t\t\t</label>\n\t\t\t\t<svg aria-hidden=\"true\" viewBox=\"0 0 571.4 571.4\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M571 393Q571 407 561 418L311 668Q300 679 286 679T261 668L11 418Q0 407 0 393T11 368 36 357H536Q550 357 561 368T571 393Z\"></path></svg>\t\t\t\n\t\t\t<select name=\"form_fields\" id=\"form-field-heard\">\n\t\t\t\t\t\t\t\t\t<option value=\"recommendation\">Recommendation</option>\n\t\t\t\t\t\t\t\t\t<option value=\"alumni\">Alumni of a Hippocrates programme</option>\n\t\t\t\t\t\t\t\t\t<option value=\"search\">Search</option>\n\t\t\t\t\t\t\t\t\t<option value=\"event\">Event or conference</option>\n\t\t\t\t\t\t\t\t\t<option value=\"press\">Press or media</option>\n\t\t\t\t\t\t\t\t\t<option value=\"other\">Other</option>\n\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t\t\t\t\t<label for=\"form-field-message\">\n\t\t\t\t\t\t\t\tWhat would you like support with?\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t<textarea name=\"form_fields\" id=\"form-field-message\" rows=\"4\" placeholder=\"Briefly share your goals. Please do not include confidential medical information.\"></textarea>\t\t\t\t\n\t\t\t\t\t<input type=\"checkbox\" value=\"yes\" id=\"form-field-consent-0\" name=\"form_fields\"> <label for=\"form-field-consent-0\">I agree to the processing of my personal data so the team can respond to my enquiry.</label>\t\t\t\t\n\t\t\t\t\t<input type=\"checkbox\" value=\"yes\" id=\"form-field-updates-0\" name=\"form_fields\"> <label for=\"form-field-updates-0\">I would like to receive occasional program news and wellness updates.</label>\t\t\t\t\n\t\t\t\t\t<button type=\"submit\">\n\t\t\t\t\t\t\t\t\t<svg aria-hidden=\"true\" viewBox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M190.5 66.9l22.2-22.2c9.4-9.4 24.6-9.4 33.9 0L441 239c9.4 9.4 9.4 24.6 0 33.9L246.6 467.3c-9.4 9.4-24.6 9.4-33.9 0l-22.2-22.2c-9.5-9.5-9.3-25 .4-34.3L311.4 296H24c-13.3 0-24-10.7-24-24v-32c0-13.3 10.7-24 24-24h287.4L190.9 101.2c-9.8-9.3-10-24.8-.4-34.3z\"></path></svg>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tSend my enquiry\n\t\t\t\t\t</button>\n\t\t</form>\n\t\t\t\t\t\t\t\t\t\t\t<p>Secure enquiry · No payment required<br />\nTypical response time: 1–2 business days.</p>\n\t\t\t\t\t\t\t\t\tReceived\n\t\t\t\t\t\t\t\t<h3 tabindex=\"-1\">Your enquiry has reached the team</h3>\n\t\t\t\t\t\t\t\t\t<p>Someone will read what you have written and come back to you within 1&ndash;2 business days. There is nothing to pay and nothing else to do.</p>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"/\">Return to Hippocrates Wellness &rarr;</a>\n\t\t\t</section>", "seoTitle": null, "seoDesc": null, "canonical": null, "ogTitle": null, "ogDesc": null, "image": null, "terms": {}, "elementor": true}
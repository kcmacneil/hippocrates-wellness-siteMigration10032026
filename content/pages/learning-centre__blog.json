{"id": "480", "type": "page", "slug": "blog", "path": "learning-centre/blog", "title": "Blog", "date": "2025-04-14 22:30:03", "modified": "2026-08-21 15:34:04", "excerpt": "", "content": "<h2>Home / </h2>\t\t\t\t\n\t\t\t\t\t<h2><a href=\"/learning-centre/\"> Online Learning / </a></h2>\t\t\t\t\n\t\t\t\t\t<h1>Keep up with the latest news from Hippocrates &amp; our lifestyle.</h1>\t\t\t\t\n\t\t<p>Constantly updated posts featuring transformation stories, Q&amp;As and healing advice for you and your family.</p>\t\t\n\t\t\t\t\n\t\t\t\t\t\t<style id=\"hw-base-css\">\n\t.hw-scope{\n\t  --green-950:#0f1d17; --green-900:#12241c; --green-800:#1b3327;\n\t  --green-700:#1f4536; --green-600:#2a5a45; --green-500:#4a7360;\n\t  --green-400:#6e937f; --green-300:#9cb7a4; --green-200:#c4d3c7;\n\t  --green-100:#e3ebe4;\n\t  --sand-50:#faf8f3; --sand-100:#f6f3ec; --sand-200:#efe9dd;\n\t  --sand-300:#e5ddcc; --sand-400:#d4c9b2;\n\t  --ink-900:#16241d; --ink-700:#33453b; --ink-500:#5c6b60; --ink-300:#8b968c;\n\t  --clay-600:#a9702f; --clay-500:#c08a4a; --clay-400:#d3a874; --clay-200:#ecd9c1;\n\t  --color-bg-primary:var(--sand-100); --color-bg-secondary:var(--sand-200);\n\t  --color-bg-elevated:var(--sand-50); --color-bg-dark:var(--green-800);\n\t  --color-bg-immersive:var(--green-950);\n\t  --color-text-primary:var(--ink-900); --color-text-secondary:var(--ink-700);\n\t  --color-text-muted:var(--ink-500); --color-text-light:var(--sand-100);\n\t  --color-text-light-secondary:var(--green-200);\n\t  --color-text-light-muted:var(--green-300);\n\t  --color-border-on-dark:rgba(246,243,236,.18);\n\t  --color-brand-primary:var(--green-700); --color-interactive:var(--green-700);\n\t  --color-interactive-hover:var(--green-800);\n\t  --color-accent:var(--clay-500); --color-accent-strong:var(--clay-600);\n\t  --color-link:var(--green-700); --color-link-hover:var(--clay-600);\n\t  --color-border-subtle:var(--sand-300);\n\t  --color-border-strong:var(--green-400);\n\t  --status-error:#a6372e; --status-success:#3f6b4b;\n\t  --color-disabled-bg:var(--sand-300); --color-disabled-text:var(--ink-300);\n\t  --fs-label:.8125rem; --fs-caption:.8125rem;\n\t  --ls-label:.04em;\n\t  --font-serif:'Newsreader',Georgia,serif;\n\t  --font-sans:'Hanken Grotesk',system-ui,sans-serif;\n\t  --font-display:var(--font-serif); --font-heading:var(--font-serif);\n\t  --font-ui:var(--font-sans); --font-body:var(--font-sans);\n\t  --fs-h1:clamp(2.25rem,1.4rem + 3.6vw,3.75rem);\n\t  --fs-h2:clamp(1.85rem,1.3rem + 2.2vw,2.75rem);\n\t  --fs-h3:clamp(1.4rem,1.15rem + 1.1vw,1.95rem);\n\t  --fs-quote:clamp(1.5rem,1.1rem + 1.6vw,2.25rem);\n\t  --fs-h4:clamp(1.2rem,1.05rem + .6vw,1.5rem);\n\t  --fs-body:1.0625rem; --fs-body-sm:.9375rem;\n\t  --fs-body-lg:clamp(1.125rem,1.05rem + .35vw,1.3rem);\n\t  --fs-eyebrow:.75rem; --fs-button:.9375rem;\n\t  --fw-light:300; --fw-regular:400; --fw-semibold:600;\n\t  --lh-heading:1.16; --lh-body:1.65; --lh-relaxed:1.75; --lh-snug:1.35;\n\t  --ls-heading:-.01em; --ls-eyebrow:.22em; --ls-button:.02em;\n\t  --space-2xs:.5rem; --space-xs:.75rem; --space-sm:1rem; --space-md:1.5rem;\n\t  --space-lg:2.5rem; --space-xl:4rem; --space-2xl:6rem;\n\t  --space-section:clamp(4rem,2.5rem + 6vw,8rem);\n\t  --container-main:1200px; --container-wide:1440px; --gutter:clamp(1.25rem,.5rem + 3vw,3.5rem);\n\t  --radius-sm:4px; --radius-md:8px; --radius-lg:16px; --radius-xl:24px;\n\t  --shadow-sm:0 2px 8px rgba(22,36,29,.06),0 1px 2px rgba(22,36,29,.04);\n\t  --dur-cinematic:900ms; --ease-entrance:cubic-bezier(.16,1,.3,1);\n\t  --dur-fast:180ms; --dur-base:320ms; --dur-slow:560ms;\n\t  --ease-standard:cubic-bezier(.4,0,.2,1);\n\t}\n\t/* A tutta pagina, indipendente dal Container che ospita il widget.\n\t   Il kit Elementor applica a ogni Container un padding laterale\n\t   clamp(1rem,.5rem + 1.5vw,2rem): senza questa regola ogni sezione\n\t   mostrerebbe due bande ai lati, e andrebbe azzerato a mano 43 volte.\n\t   La larghezza si prende dal viewport e i margini negativi annullano\n\t   qualunque padding il genitore imponga. */\n\t.hw-scope.hw-fullbleed{width:100vw;max-width:100vw;\n\t  margin-inline:calc(50% - 50vw)}\n\t/* impaginazione */\n\t.hw-scope .hw-container{width:100%;max-width:var(--container-main);\n\t  margin-inline:auto;padding-inline:var(--gutter)}\n\t/* Il contenitore largo del design system: 1440px invece di 1200. Serve\n\t   alla striscia dei fatti sotto l'hero, che a 1200 non ci sta su una\n\t   riga e va a capo — nel prototipo le quattro voci sono affiancate. */\n\t.hw-scope .hw-container--wide{max-width:var(--container-wide)}\n\t.hw-scope.hw-section{padding-block:var(--space-section);\n\t  background:var(--color-bg-primary)}\n\t.hw-scope.hw-section--secondary{background:var(--color-bg-secondary)}\n\t.hw-scope.hw-section--dark{background:var(--color-bg-dark);\n\t  color:var(--color-text-light)}\n\t/* Stava dentro due widget, e chi ne usava un terzo su fondo immersivo si\n\t   ritrovava testo chiaro su carta chiara. Le quattro superfici di pagina\n\t   sono una scelta del design system: appartengono alla base, non a un\n\t   componente che per caso e in pagina. */\n\t.hw-scope.hw-section--immersive{background:var(--color-bg-immersive);\n\t  color:var(--color-text-light)}\n\t/* Le righe etichetta/valore le stampa hw_righe_elenco(), che e condivisa\n\t   fra griglia e split: il loro vestito sta qui, non dentro un widget che\n\t   potrebbe non essere in pagina. */\n\t.hw-scope .hw-card__dl{margin:0;display:grid;gap:.5rem}\n\t.hw-scope .hw-card__dl dt{font-family:var(--font-ui);\n\t  font-size:var(--fs-caption);font-weight:var(--fw-semibold);\n\t  text-transform:uppercase;letter-spacing:var(--ls-eyebrow);\n\t  color:var(--color-text-muted);margin:0}\n\t.hw-scope .hw-card__dl dd{margin:0;font-family:var(--font-body);\n\t  font-size:var(--fs-body-sm);line-height:var(--lh-body);\n\t  color:var(--color-text-secondary)}\n\t/* tipografia */\n\t.hw-scope .hw-eyebrow{display:inline-flex;align-items:center;\n\t  gap:var(--space-xs);font-family:var(--font-ui);font-size:var(--fs-eyebrow);\n\t  font-weight:var(--fw-semibold);letter-spacing:var(--ls-eyebrow);\n\t  text-transform:uppercase;color:var(--color-accent-strong)}\n\t.hw-scope .hw-eyebrow--soft{color:var(--color-accent)}\n\t.hw-scope .hw-h2{font-family:var(--font-heading);font-size:var(--fs-h2);\n\t  font-weight:var(--fw-regular);line-height:var(--lh-heading);\n\t  letter-spacing:var(--ls-heading);color:var(--color-text-primary);\n\t  /* 19em, non 26ch: in `ch` la misura dipende dalle metriche del font\n\t     servito, e a 26ch «What a stay at Hippocrates feels like» andava a\n\t     capo mentre nel prototipo sta su una riga. Il prototipo arriva a 34ch\n\t     sui titoli piu lunghi; qui una misura sola, larga abbastanza per\n\t     quelli brevi e ancora stretta per i discorsivi. */\n\t  margin:var(--space-xs) 0 0;max-width:19em;text-wrap:balance}\n\t.hw-scope .hw-body{font-family:var(--font-body);font-size:var(--fs-body-lg);\n\t  line-height:var(--lh-relaxed);color:var(--color-text-secondary);\n\t  max-width:58ch;margin:var(--space-sm) 0 0}\n\t.hw-scope.hw-section--dark .hw-h2{color:var(--color-text-light)}\n\t.hw-scope.hw-section--dark .hw-body{color:var(--color-text-light-secondary)}\n\t/* media */\n\t.hw-scope .hw-mediaframe{aspect-ratio:16/10;background:var(--sand-300);\n\t  border-radius:var(--radius-lg);overflow:hidden;position:relative}\n\t.hw-scope .hw-mediaframe img{display:block;width:100%;height:100%;\n\t  object-fit:cover;max-width:100%;border:0}\n\t/* azioni */\n\t.hw-scope .hw-actions{display:flex;gap:var(--space-sm);flex-wrap:wrap;\n\t  margin-top:var(--space-lg);align-items:center}\n\t.hw-scope .hw-actions a,.hw-scope .hw-textlink{text-decoration:none;\n\t  font-family:var(--font-ui);font-weight:var(--fw-semibold);\n\t  letter-spacing:var(--ls-button);display:inline-flex;align-items:center;\n\t  gap:var(--space-2xs);\n\t  transition:background var(--dur-base) var(--ease-standard),\n\t             color var(--dur-base) var(--ease-standard)}\n\t.hw-scope .hw-btn--primary{background:var(--color-interactive);\n\t  color:var(--color-text-light);border:1.5px solid var(--color-interactive);\n\t  border-radius:var(--radius-sm);padding:.9rem 1.75rem;\n\t  font-size:var(--fs-button);line-height:1;white-space:nowrap}\n\t.hw-scope .hw-btn--primary:hover{background:var(--color-interactive-hover);\n\t  border-color:var(--color-interactive-hover);box-shadow:var(--shadow-sm)}\n\t.hw-scope .hw-btn--light-lg{background:var(--color-text-light);\n\t  color:var(--green-800);border:1.5px solid var(--color-text-light);\n\t  border-radius:var(--radius-sm);padding:1.1rem 2.25rem;font-size:1rem;\n\t  line-height:1;white-space:nowrap}\n\t.hw-scope .hw-btn--light-lg:hover{background:var(--sand-200)}\n\t/* Il secondo pulsante su fondo scuro: stesso ingombro del primo, peso\n\t   diverso. Il bordo e a piena opacita perche su una fotografia un bordo\n\t   sbiadito sparisce, e con lui l'affordance. */\n\t.hw-scope .hw-btn--outline-light-lg{background:transparent;\n\t  color:var(--color-text-light);border:1.5px solid var(--color-text-light);\n\t  border-radius:var(--radius-sm);padding:1.1rem 2.25rem;font-size:1rem;\n\t  line-height:1;white-space:nowrap}\n\t.hw-scope .hw-btn--outline-light-lg:hover{background:rgba(246,243,236,.12)}\n\t.hw-scope .hw-btn--outline{background:transparent;\n\t  color:var(--color-interactive);border:1.5px solid var(--color-interactive);\n\t  border-radius:var(--radius-sm);padding:.9rem 1.75rem;\n\t  font-size:var(--fs-button);line-height:1;white-space:nowrap}\n\t.hw-scope .hw-btn--outline:hover{background:var(--color-interactive);\n\t  color:var(--color-text-light)}\n\t.hw-scope .hw-textlink{color:var(--color-link);font-size:var(--fs-button);\n\t  border-bottom:1.5px solid;padding-bottom:2px}\n\t.hw-scope .hw-textlink:hover{color:var(--color-link-hover);\n\t  border-bottom-color:var(--color-link-hover)}\n\t.hw-scope .hw-textlink--light{color:var(--color-text-light)}\n\t.hw-scope .hw-textlink--light:hover{color:var(--clay-200);\n\t  border-bottom-color:var(--clay-200)}\n\t/* Elenchi puntati. Il marcatore e disegnato, non scritto: un carattere\n\t   nel contenuto verrebbe letto ad alta voce a ogni riga, e un simbolo\n\t   ripetuto venti volte e rumore, non informazione. */\n\t.hw-scope .hw-nota.hw-nota--azione{margin-top:var(--space-sm);\n\t  font-family:var(--font-ui);font-size:var(--fs-body-sm);\n\t  color:var(--color-text-muted);max-width:60ch}\n\t.hw-scope.hw-section--dark .hw-nota--azione,\n\t.hw-scope.hw-section--immersive .hw-nota--azione{\n\t  color:var(--color-text-light-secondary)}\n\t.hw-scope .hw-lista{list-style:none;margin:var(--space-sm) 0 0;padding:0;\n\t  display:grid;gap:var(--space-2xs)}\n\t.hw-scope .hw-lista li{position:relative;padding-left:1.7rem;\n\t  font-family:var(--font-body);font-size:var(--fs-body);\n\t  line-height:var(--lh-body);color:var(--color-text-secondary)}\n\t.hw-scope .hw-lista li::before{content:\"\";position:absolute;left:.3rem;\n\t  top:calc(var(--lh-body) * .5em - .19rem);width:.38rem;height:.38rem;\n\t  background:var(--color-accent);transform:rotate(45deg)}\n\t/* variante con la spunta: due lati di un quadrato, ruotati */\n\t.hw-scope .hw-lista--punto li::before{width:.3rem;height:.3rem;\n\t  border-radius:50%;transform:none;background:var(--color-text-muted);\n\t  top:calc(var(--lh-body) * .5em - .15rem)}\n\t.hw-scope .hw-lista--check li::before{width:.34rem;height:.62rem;\n\t  background:none;border:solid var(--clay-400);border-width:0 2px 2px 0;\n\t  transform:rotate(42deg);left:.34rem;\n\t  top:calc(var(--lh-body) * .5em - .44rem)}\n\t.hw-scope.hw-section--dark .hw-lista li,\n\t.hw-scope.hw-section--immersive .hw-lista li{color:var(--sand-100)}\n\t/* Su fondo scuro i pulsanti cambiano verso. Il verde del marchio non si\n\t   stacca dal verde della sezione, e un link verde scuro su verde scuro\n\t   non si vede affatto: sono tre classi perche devono battere le regole\n\t   di base, che ne hanno due. */\n\t.hw-scope.hw-section--dark .hw-btn--primary,\n\t.hw-scope.hw-section--immersive .hw-btn--primary{\n\t  background:var(--color-text-light);color:var(--green-800);\n\t  border-color:var(--color-text-light)}\n\t.hw-scope.hw-section--dark .hw-btn--primary:hover,\n\t.hw-scope.hw-section--immersive .hw-btn--primary:hover{\n\t  background:var(--sand-200);border-color:var(--sand-200);\n\t  color:var(--green-800);box-shadow:none}\n\t.hw-scope.hw-section--dark .hw-btn--outline,\n\t.hw-scope.hw-section--immersive .hw-btn--outline{\n\t  color:var(--color-text-light);border-color:var(--color-text-light);\n\t  background:transparent}\n\t.hw-scope.hw-section--dark .hw-btn--outline:hover,\n\t.hw-scope.hw-section--immersive .hw-btn--outline:hover{\n\t  background:rgba(246,243,236,.12);color:var(--color-text-light)}\n\t.hw-scope.hw-section--dark .hw-textlink,\n\t.hw-scope.hw-section--immersive .hw-textlink{color:var(--color-text-light)}\n\t.hw-scope.hw-section--dark .hw-textlink:hover,\n\t.hw-scope.hw-section--immersive .hw-textlink:hover{\n\t  color:var(--clay-200);border-bottom-color:var(--clay-200)}\n\t/* Anteprima di un video. Il triangolo e il velo dicono che si apre\n\t   qualcosa: senza, una foto ferma resta solo una foto. */\n\t.hw-scope .hw-poster{position:relative;display:block;width:100%;padding:0;\n\t  border:0;border-radius:var(--radius-lg);overflow:hidden;\n\t  background:var(--green-950);cursor:pointer}\n\t.hw-scope .hw-poster img{width:100%;height:100%;object-fit:cover;\n\t  display:block;max-width:100%;border:0}\n\t.hw-scope .hw-poster__veil{position:absolute;inset:0;\n\t  background:linear-gradient(180deg,rgba(15,29,23,.12) 0%,\n\t  rgba(15,29,23,.16) 55%,rgba(15,29,23,.72) 100%)}\n\t.hw-scope .hw-poster__play{position:absolute;top:50%;left:50%;\n\t  transform:translate(-50%,-50%);width:78px;height:78px;border-radius:50%;\n\t  border:1px solid rgba(246,243,236,.75);background:rgba(15,29,23,.42);\n\t  display:grid;place-items:center;color:var(--sand-100);font-size:20px;\n\t  padding-left:4px;\n\t  transition:transform var(--dur-base) var(--ease-standard),\n\t             background var(--dur-base) var(--ease-standard)}\n\t.hw-scope .hw-poster:hover .hw-poster__play,\n\t.hw-scope .hw-poster:focus-visible .hw-poster__play{\n\t  transform:translate(-50%,-50%) scale(1.06);background:rgba(15,29,23,.62)}\n\t.hw-scope .hw-poster__meta{position:absolute;left:var(--space-md);\n\t  right:var(--space-md);bottom:var(--space-md);display:grid;gap:.15rem;\n\t  text-align:left;pointer-events:none}\n\t/* Il poster e un <button>, e il kit maiuscola ogni pulsante del sito. Qui\n\t   dentro c'e il nome di una persona: va letto com'e scritto. */\n\t.hw-scope .hw-poster{text-transform:none;letter-spacing:normal;\n\t  font-weight:var(--fw-regular)}\n\t.hw-scope .hw-poster__nome{font-family:var(--font-heading);\n\t  font-size:var(--fs-h4);color:var(--sand-100);\n\t  text-transform:none;letter-spacing:normal;font-weight:var(--fw-regular)}\n\t.hw-scope .hw-poster__ruolo{font-family:var(--font-ui);\n\t  font-size:var(--fs-caption);color:var(--green-200);\n\t  text-transform:none;letter-spacing:normal;font-weight:var(--fw-regular)}\n\t@media(prefers-reduced-motion:reduce){\n\t  .hw-scope .hw-poster:hover .hw-poster__play{transform:translate(-50%,-50%)}}\n\t.hw-scope .hw-btn__icon{display:inline-flex;\n\t  transition:transform var(--dur-base) var(--ease-standard)}\n\t.hw-scope a:hover .hw-btn__icon{transform:translateX(4px)}\n\t.hw-scope a:focus-visible{outline:none;\n\t  box-shadow:0 0 0 3px rgba(192,138,74,.55);border-radius:2px}\n\t@media(prefers-reduced-motion:reduce){\n\t  .hw-scope a:hover .hw-btn__icon{transform:none}}\n\t/* La lightbox sta in fondo al <body>, fuori da ogni sezione: le sue\n\t   regole non possono stare sotto .hw-scope. */\n\t/* Il riquadro del video vive attaccato al <body>, fuori da .hw-scope:\n\t   qui i selettori non possono partire da li, e senza precauzioni le\n\t   regole del kit — che vestono ogni <button> del sito — vincono. Il\n\t   pulsante di chiusura usciva fucsia, a pastiglia e in maiuscolo.\n\t   Ogni regola va quindi a due classi. */\n\t.hw-lightbox{position:fixed;inset:0;\n\t  /* sopra tutto: l'intestazione del sito e appiccicata in alto e con un\n\t     valore piu basso finiva davanti al video, proprio dove sta il\n\t     pulsante per chiudere */\n\t  z-index:999999;\n\t  background:rgba(9,18,14,.94);display:grid;place-items:center;\n\t  padding:clamp(1rem,4vw,3rem)}\n\t.hw-lightbox .hw-lightbox__box{position:relative;width:min(1100px,100%);\n\t  display:flex;flex-direction:column;gap:.6rem}\n\t.hw-lightbox .hw-lightbox__frame{position:relative;aspect-ratio:16/9;\n\t  width:100%;background:#0f1d17;border-radius:12px;overflow:hidden}\n\t.hw-lightbox .hw-lightbox__frame iframe{position:absolute;inset:0;\n\t  width:100%;height:100%;border:0;z-index:1}\n\t/* Sopra la cornice, non dentro: Vimeo mette i propri comandi in alto a\n\t   destra — orologio e condivisione — e li stavamo coprendo. Fuori dal\n\t   video non puo sovrapporsi a niente, e ora che il riquadro sta sopra\n\t   l'intestazione quel posto e di nuovo raggiungibile.\n\t   In flusso normale, non in posizione assoluta: cosi su uno schermo\n\t   basso il riquadro si stringe invece di tagliarlo via. */\n\t.hw-lightbox .hw-lightbox__chiudi{align-self:flex-end;flex-shrink:0;\n\t  width:48px;height:48px;min-width:0;padding:0;\n\t  display:grid;place-items:center;\n\t  border-radius:50%;border:1px solid rgba(246,243,236,.45);\n\t  background:rgba(9,18,14,.72);color:#f6f3ec;\n\t  font-family:inherit;font-size:18px;font-weight:400;line-height:1;\n\t  text-transform:none;letter-spacing:normal;cursor:pointer;\n\t  transition:background .18s cubic-bezier(.4,0,.2,1)}\n\t.hw-lightbox .hw-lightbox__chiudi:hover,\n\t.hw-lightbox .hw-lightbox__chiudi:focus{background:rgba(9,18,14,.92);\n\t  border-color:rgba(246,243,236,.75);color:#f6f3ec}\n\t.hw-lightbox .hw-lightbox__chiudi:focus-visible{outline:none;\n\t  box-shadow:0 0 0 3px rgba(192,138,74,.55)}\n\t</style>\n\t\t\t\t<style id=\"hw-marchi-css\">\n\t\t\t.hw-scope.hw-marchi-sez{padding-block:var(--space-xl)}\n\t\t\t.hw-scope .hw-marchi__testa{margin-bottom:var(--space-md);\n\t\t\t  text-align:center}\n\t\t\t.hw-scope .hw-marchi__etichetta{font-family:var(--font-ui);\n\t\t\t  font-size:var(--fs-caption);font-weight:var(--fw-semibold);\n\t\t\t  letter-spacing:var(--ls-eyebrow);text-transform:uppercase;\n\t\t\t  color:var(--color-text-muted)}\n\t\t\t/* La sfumatura ai due lati dice che la striscia continua oltre il\n\t\t\t   bordo, invece di farla sembrare tagliata. */\n\t\t\t.hw-scope .hw-marchi__mascherina{overflow:hidden;\n\t\t\t  -webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);\n\t\t\t  mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}\n\t\t\t.hw-scope .hw-marchi__nastro{display:flex;width:max-content;\n\t\t\t  animation-name:hw-marchi;animation-timing-function:linear;\n\t\t\t  animation-iteration-count:infinite}\n\t\t\t.hw-scope .hw-marchi__gruppo{display:flex;flex-shrink:0;\n\t\t\t  gap:var(--space-2xl);padding-right:var(--space-2xl)}\n\t\t\t/* 150x75 come i file forniti: la cornice ha lo stesso rapporto e il\n\t\t\t   bianco del JPG non lascia aloni sul fondo sabbia. */\n\t\t\t.hw-scope .hw-marchi__logo{display:block;flex-shrink:0;\n\t\t\t  width:150px;height:75px;overflow:hidden;\n\t\t\t  border:1px solid var(--color-border-subtle);\n\t\t\t  border-radius:var(--radius-sm)}\n\t\t\t.hw-scope .hw-marchi__img{display:block;width:100%;height:100%;\n\t\t\t  object-fit:contain}\n\t\t\t.hw-scope .hw-marchi__nota{margin-top:var(--space-md);text-align:center;\n\t\t\t  font-family:var(--font-ui);font-size:var(--fs-caption);\n\t\t\t  color:var(--color-text-muted)}\n\t\t\t.hw-scope.hw-section--dark .hw-marchi__etichetta,\n\t\t\t.hw-scope.hw-section--dark .hw-marchi__nota{\n\t\t\t  color:var(--color-text-light-muted)}\n\t\t\t.hw-scope.hw-section--dark .hw-marchi__logo{\n\t\t\t  border-color:var(--color-border-on-dark)}\n\t\t\t@keyframes hw-marchi{\n\t\t\t  from{transform:translateX(0)} to{transform:translateX(-50%)}\n\t\t\t}\n\t\t\t/* Ferma il nastro, non lo nasconde: chi ha chiesto meno movimento\n\t\t\t   vuole leggere gli stessi marchi, scorrendoli da se. */\n\t\t\t@media(prefers-reduced-motion:reduce){\n\t\t\t  .hw-scope .hw-marchi__nastro{animation:none}\n\t\t\t  .hw-scope .hw-marchi__mascherina{overflow-x:auto}\n\t\t\t}\n\t\t\t</style>\n\t\t\t\t\t\t<section>\n\t\t\t\t\t\tAccreditations &amp; associations\n\t\t\t\t\t\t<img\n\t\t\t\t\t\t     src=\"/wp-content/uploads/2026/08/hw-logos-wellness-travel-guide-4.jpg\"\n\t\t\t\t\t\t     alt=\"Wellness Travel Guide 2017 — Organic Spa Media\"\n\t\t\t\t\t\t     width=\"150\" height=\"75\" loading=\"lazy\">\n\t\t\t\t\t\t<img\n\t\t\t\t\t\t     src=\"/wp-content/uploads/2026/08/hw-logos-bbb-accredited-4.jpg\"\n\t\t\t\t\t\t     alt=\"BBB Accredited Business\"\n\t\t\t\t\t\t     width=\"150\" height=\"75\" loading=\"lazy\">\n\t\t\t\t\t\t<img\n\t\t\t\t\t\t     src=\"/wp-content/uploads/2026/08/hw-logos-vegan-of-the-year-4.jpg\"\n\t\t\t\t\t\t     alt=\"Vegan of the Year 2014 — Winner\"\n\t\t\t\t\t\t     width=\"150\" height=\"75\" loading=\"lazy\">\n\t\t\t\t\t\t<img\n\t\t\t\t\t\t     src=\"/wp-content/uploads/2026/08/hw-logos-tripadivisor-4.jpg\"\n\t\t\t\t\t\t     alt=\"Tripadvisor Certificate of Excellence 2018\"\n\t\t\t\t\t\t     width=\"150\" height=\"75\" loading=\"lazy\">\n\t\t\t\t\t\t<img\n\t\t\t\t\t\t     src=\"/wp-content/uploads/2026/08/hw-logos-spas-of-america-4.jpg\"\n\t\t\t\t\t\t     alt=\"Spas of America — Top 100 Spas 2019\"\n\t\t\t\t\t\t     width=\"150\" height=\"75\" loading=\"lazy\">\n\t\t\t\t\t\t<img\n\t\t\t\t\t\t     src=\"/wp-content/uploads/2026/08/hw-logos-ispa-4.jpg\"\n\t\t\t\t\t\t     alt=\"International SPA Association\"\n\t\t\t\t\t\t     width=\"150\" height=\"75\" loading=\"lazy\">\n\t\t\t\t\t\t<img\n\t\t\t\t\t\t     src=\"/wp-content/uploads/2026/08/hw-logos-hispanic-chamber-of-commerce-4.jpg\"